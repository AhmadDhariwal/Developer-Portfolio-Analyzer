# DevInsight AI backend configuration. Copy to backend/.env only for a NEW setup.
# Existing installations: merge missing keys; never overwrite credentials or data.
# This file contains placeholders, not credentials. See verification/tech-news/PRODUCTION-SETUP.md.

# Application / database (startup uses MONGODB_URI, not MONGO_URI)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devinsight
FRONTEND_BASE_URL=http://localhost:4200
APP_NAME="DevInsight AI"

# Authentication: replace before use with a cryptographically random secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=20h
JWT_ISSUER=devinsight-api
JWT_AUDIENCE=devinsight-web
SECURITY_STRICT_ENV=true
# Optional; preserve the existing key on upgrades to decrypt stored settings.
# When absent, existing code derives the settings key from JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=
# Retained legacy variable; current OAuth state-cookie names are provider-specific.
AUTH_COOKIE_NAME=devinsight_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Redis: native TCP/TLS, NOT the Upstash REST URL or REST bearer token.
# REDIS_URL takes precedence over the UPSTASH_* fields; leave one form unused.
# Example URL shape: rediss://default:<url-encoded-database-password>@<host>:6379
REDIS_URL=
UPSTASH_REDIS_HOST=
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_TOKEN=

# Existing AI / course integrations (optional; preserve current models/keys on upgrade).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_COOLDOWN_MS=1800000
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_COOLDOWN_MS=180000
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# Existing job integrations. Missing credentials leave the corresponding source unavailable.
RAPIDAPI_KEY=
JSEARCH_TIMEOUT_MS=10000
# Retained legacy variable; current job source code has no consumer for this setting.
JSEARCH_RETRIES=0
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
JOB_SOURCE_TIMEOUT_MS=9000
JOB_CACHE_TTL_HOURS=36
JOB_SOURCE_SYNC_INTERVAL_MS=14400000

# OAuth: register your own application callbacks. Legacy GitHub names remain supported.
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
GITHUB_AUTH_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
INTEGRATION_SYNC_INTERVAL_MS=300000
INTEGRATION_SYNC_BATCH_SIZE=10
INTEGRATION_DEFAULT_SYNC_INTERVAL_MIN=30
INTEGRATION_WEBHOOK_SECRET=

# Email / support: configure SendGrid or the existing SMTP path as needed.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
EMAIL_USER=
EMAIL_PASS=
SUPPORT_INBOX_EMAIL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE_NUMBER=

# Weekly report scheduling: opt in deliberately on a new installation.
WEEKLY_REPORT_SCHEDULER_ENABLED=false
WEEKLY_REPORT_CRON="0 8 * * 1"
WEEKLY_REPORT_TIMEZONE=Asia/Karachi
WEEKLY_REPORT_DRY_RUN=true
WEEKLY_REPORT_SCHEDULER_DRY_RUN=true

# Existing security / observability controls
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_MAX=20
BRUTE_FORCE_MAX_ATTEMPTS=6
# Retained legacy variable; current brute-force guard uses platform security settings.
BRUTE_FORCE_LOCKOUT_MS=900000
LOG_LEVEL=info
OTEL_SERVICE_NAME=developer-portfolio-analyzer-api
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ALERT_LATENCY_MS=1800
METRICS_ALERT_ERROR_RATE=0.2

# TECH NEWS CONFIGURATION — START

# Core
# Run scheduled ingestion and the discovery worker; boolean, false stops both. Default: true. Restart backend after changes.
NEWS_INGESTION_ENABLED=true
# Allow public query discovery; boolean, platform newsEnabled also applies. Default: true. Restart backend after changes.
NEWS_DISCOVERY_ENABLED=true

# Search
# Maximum results per source request; integer 1..30, metadata only. Default: 30. Restart backend after changes.
NEWS_DISCOVERY_RESULTS_PER_PROVIDER=30
# Minimum time between successful manual query checks; milliseconds 60000..3600000, never bypasses source limits. Default: 60000. Restart backend after changes.
NEWS_REFRESH_MIN_INTERVAL_MS=60000

# Background Workers
# Enable hourly prewarm admission; boolean, consumes the shared job budget. Default: true. Restart backend after changes.
NEWS_DISCOVERY_PREWARM_ENABLED=true
# Up to four comma-separated public technology phrases; no URLs or private queries. Default: devops,kubernetes,security,ai. Restart backend after changes.
NEWS_DISCOVERY_PREWARM_TOPICS=devops,kubernetes,security,ai
# Prewarm admissions per UTC day; integer 0..4, zero stops prewarming. Default: 4. Restart backend after changes.
NEWS_DISCOVERY_PREWARM_DAILY_JOBS=4

# User / Global Limits
# All query jobs per UTC day across accounts and prewarm; integer 1..48. Default: 12. Restart backend after changes.
NEWS_DISCOVERY_DAILY_JOBS=12
# New query jobs per account per UTC minute; integer 1..12, existing jobs are reused. Default: 3. Restart backend after changes.
NEWS_DISCOVERY_USER_MINUTE_JOBS=3
# New query jobs per account per UTC day; integer 1..48. Default: 6. Restart backend after changes.
NEWS_DISCOVERY_USER_DAILY_JOBS=6

# Cache
# Positive query freshness; milliseconds 60000..3600000, ordinary reads do not revalidate fresh results. Default: 1800000. Restart backend after changes.
NEWS_QUERY_FRESH_TTL_MS=1800000
# Absolute article retention; milliseconds 3600000..86400000, at least fresh TTL; reads never extend it. Default: 86400000. Restart backend after changes.
NEWS_QUERY_STALE_TTL_MS=86400000
# Successful empty-query retention; milliseconds 30000..900000, failures are not empty results. Default: 300000. Restart backend after changes.
NEWS_QUERY_NEGATIVE_TTL_MS=300000
# Maximum query entries per in-process cache; integer 40..256, shared Redis versions invalidate memory. Default: 128. Restart backend after changes.
NEWS_QUERY_MEMORY_ENTRIES=128

# Redis Governance
# HACKERNEWS combined adapter requests per UTC day; integer 0..2000, zero blocks requests; broad ingestion reserves search headroom. Default: 84. Restart backend after changes.
NEWS_HACKERNEWS_SHARED_DAILY_BUDGET=84
# HACKERNEWS combined adapter requests per UTC month; integer 0..60000, zero blocks requests. Default: 2500. Restart backend after changes.
NEWS_HACKERNEWS_SHARED_MONTHLY_BUDGET=2500
# HACKERNEWS minimum spacing across adapters; milliseconds 0..86400000, hard floor 60000. Default: 60000. Restart backend after changes.
NEWS_HACKERNEWS_SHARED_MIN_INTERVAL_MS=60000
# DEVTO combined adapter requests per UTC day; integer 0..2000, zero blocks requests; broad ingestion reserves search headroom. Default: 84. Restart backend after changes.
NEWS_DEVTO_SHARED_DAILY_BUDGET=84
# DEVTO combined adapter requests per UTC month; integer 0..60000, zero blocks requests. Default: 2500. Restart backend after changes.
NEWS_DEVTO_SHARED_MONTHLY_BUDGET=2500
# DEVTO minimum spacing across adapters; milliseconds 0..86400000, hard floor 60000. Default: 60000. Restart backend after changes.
NEWS_DEVTO_SHARED_MIN_INTERVAL_MS=60000
# GITHUB combined adapter requests per UTC day; integer 0..2000, zero blocks requests; broad ingestion reserves search headroom. Default: 12. Restart backend after changes.
NEWS_GITHUB_SHARED_DAILY_BUDGET=12
# GITHUB combined adapter requests per UTC month; integer 0..60000, zero blocks requests. Default: 300. Restart backend after changes.
NEWS_GITHUB_SHARED_MONTHLY_BUDGET=300
# GITHUB minimum spacing across adapters; milliseconds 0..86400000, hard floor 300000. Default: 300000. Restart backend after changes.
NEWS_GITHUB_SHARED_MIN_INTERVAL_MS=300000

# Provider Settings
# hackernews content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_HACKERNEWS_CONTENT_APPROVED=true
# hackernews requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 72. Restart backend after changes.
NEWS_HACKERNEWS_DAILY_BUDGET=72
# hackernews requests per UTC month; integer 0..30000, zero blocks requests. Default: 2200. Restart backend after changes.
NEWS_HACKERNEWS_MONTHLY_BUDGET=2200
# hackernews request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_HACKERNEWS_MIN_INTERVAL_MS=1200000
# devto content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_DEVTO_CONTENT_APPROVED=true
# devto requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 72. Restart backend after changes.
NEWS_DEVTO_DAILY_BUDGET=72
# devto requests per UTC month; integer 0..30000, zero blocks requests. Default: 2200. Restart backend after changes.
NEWS_DEVTO_MONTHLY_BUDGET=2200
# devto request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_DEVTO_MIN_INTERVAL_MS=1200000
# hackernewssearch content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_HACKERNEWSSEARCH_CONTENT_APPROVED=true
# hackernewssearch requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 12. Restart backend after changes.
NEWS_HACKERNEWSSEARCH_DAILY_BUDGET=12
# hackernewssearch requests per UTC month; integer 0..30000, zero blocks requests. Default: 300. Restart backend after changes.
NEWS_HACKERNEWSSEARCH_MONTHLY_BUDGET=300
# hackernewssearch request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 60000. Restart backend after changes.
NEWS_HACKERNEWSSEARCH_MIN_INTERVAL_MS=60000
# githubreleases content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_GITHUBRELEASES_CONTENT_APPROVED=true
# githubreleases requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 6. Restart backend after changes.
NEWS_GITHUBRELEASES_DAILY_BUDGET=6
# githubreleases requests per UTC month; integer 0..30000, zero blocks requests. Default: 150. Restart backend after changes.
NEWS_GITHUBRELEASES_MONTHLY_BUDGET=150
# githubreleases request spacing; milliseconds 0..86400000, hard floor 300000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_GITHUBRELEASES_MIN_INTERVAL_MS=1200000
# githubadvisories content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_GITHUBADVISORIES_CONTENT_APPROVED=true
# githubadvisories requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 6. Restart backend after changes.
NEWS_GITHUBADVISORIES_DAILY_BUDGET=6
# githubadvisories requests per UTC month; integer 0..30000, zero blocks requests. Default: 150. Restart backend after changes.
NEWS_GITHUBADVISORIES_MONTHLY_BUDGET=150
# githubadvisories request spacing; milliseconds 0..86400000, hard floor 300000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_GITHUBADVISORIES_MIN_INTERVAL_MS=1200000
# lobsters content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: false. Restart backend after changes.
NEWS_LOBSTERS_CONTENT_APPROVED=false
# lobsters requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 6. Restart backend after changes.
NEWS_LOBSTERS_DAILY_BUDGET=6
# lobsters requests per UTC month; integer 0..30000, zero blocks requests. Default: 150. Restart backend after changes.
NEWS_LOBSTERS_MONTHLY_BUDGET=150
# lobsters request spacing; milliseconds 0..86400000, hard floor 600000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_LOBSTERS_MIN_INTERVAL_MS=1200000
# devtosearch content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_DEVTOSEARCH_CONTENT_APPROVED=true
# devtosearch requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 12. Restart backend after changes.
NEWS_DEVTOSEARCH_DAILY_BUDGET=12
# devtosearch requests per UTC month; integer 0..30000, zero blocks requests. Default: 300. Restart backend after changes.
NEWS_DEVTOSEARCH_MONTHLY_BUDGET=300
# devtosearch request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 60000. Restart backend after changes.
NEWS_DEVTOSEARCH_MIN_INTERVAL_MS=60000
# kubernetesblog content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: true. Restart backend after changes.
NEWS_KUBERNETESBLOG_CONTENT_APPROVED=true
# kubernetesblog requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 4. Restart backend after changes.
NEWS_KUBERNETESBLOG_DAILY_BUDGET=4
# kubernetesblog requests per UTC month; integer 0..30000, zero blocks requests. Default: 100. Restart backend after changes.
NEWS_KUBERNETESBLOG_MONTHLY_BUDGET=100
# kubernetesblog request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_KUBERNETESBLOG_MIN_INTERVAL_MS=1200000
# cloudflarechangelog content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: false. Restart backend after changes.
NEWS_CLOUDFLARECHANGELOG_CONTENT_APPROVED=false
# cloudflarechangelog requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 0. Restart backend after changes.
NEWS_CLOUDFLARECHANGELOG_DAILY_BUDGET=0
# cloudflarechangelog requests per UTC month; integer 0..30000, zero blocks requests. Default: 0. Restart backend after changes.
NEWS_CLOUDFLARECHANGELOG_MONTHLY_BUDGET=0
# cloudflarechangelog request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_CLOUDFLARECHANGELOG_MIN_INTERVAL_MS=1200000

# Restricted Sources
# Optional NewsAPI server credential from newsapi.org; existing platform newsApiKey is also supported; requires approval and budgets. Default: empty (optional). Restart backend after changes.
NEWS_API_KEY=
# newsapi content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: false. Restart backend after changes.
NEWS_NEWSAPI_CONTENT_APPROVED=false
# newsapi requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 0. Restart backend after changes.
NEWS_NEWSAPI_DAILY_BUDGET=0
# newsapi requests per UTC month; integer 0..30000, zero blocks requests. Default: 0. Restart backend after changes.
NEWS_NEWSAPI_MONTHLY_BUDGET=0
# newsapi request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_NEWSAPI_MIN_INTERVAL_MS=1200000
# Optional GNews server credential from gnews.io; requires commercial/content approval and budgets. Default: empty (optional). Restart backend after changes.
GNEWS_API_KEY=
# gnews content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: false. Restart backend after changes.
NEWS_GNEWS_CONTENT_APPROVED=false
# gnews requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 0. Restart backend after changes.
NEWS_GNEWS_DAILY_BUDGET=0
# gnews requests per UTC month; integer 0..30000, zero blocks requests. Default: 0. Restart backend after changes.
NEWS_GNEWS_MONTHLY_BUDGET=0
# gnews request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_GNEWS_MIN_INTERVAL_MS=1200000
# Optional Reddit OAuth access token; obtain through an approved Reddit API application; requires approval and budgets. Default: empty (optional). Restart backend after changes.
NEWS_REDDIT_ACCESS_TOKEN=
# Optional Reddit application identity; required with its token for enabled Reddit requests. Default: empty (optional). Restart backend after changes.
NEWS_REDDIT_USER_AGENT=
# reddit content-use approval; boolean, credentials alone never enable a restricted source; false blocks this adapter. Default: false. Restart backend after changes.
NEWS_REDDIT_CONTENT_APPROVED=false
# reddit requests per UTC day; integer 0..1000, zero blocks requests, failed transport attempts consume credit. Default: 0. Restart backend after changes.
NEWS_REDDIT_DAILY_BUDGET=0
# reddit requests per UTC month; integer 0..30000, zero blocks requests. Default: 0. Restart backend after changes.
NEWS_REDDIT_MONTHLY_BUDGET=0
# reddit request spacing; milliseconds 0..86400000, hard floor 60000; shared cooldown may wait longer. Default: 1200000. Restart backend after changes.
NEWS_REDDIT_MIN_INTERVAL_MS=1200000

# Verification only
# Optional disposable integration Redis TCP URL; must differ from application Redis. Default: empty (optional). Applies on next test run.
NEWS_TEST_REDIS_URL=
# Explicit acknowledgement for remote disposable Redis tests; boolean, never authorizes application Redis writes. Default: false. Applies on next test run.
NEWS_TEST_REDIS_DISPOSABLE=false
# Optional disposable integration Mongo URI; production data is prohibited. Default: empty (optional). Applies on next test run.
NEWS_TEST_MONGODB_URI=
# Optional isolated test namespace news-test:<UUID>:; blank generates a unique namespace. Default: empty (optional). Applies on next test run.
NEWS_TEST_REDIS_NAMESPACE=
# Opt in to focused Playwright browser verification; boolean. Default: false. Applies on next test run.
NEWS_TEST_BROWSER=false
# Opt in to bounded live provider verification; boolean, real quotas still apply. Default: false. Applies on next test run.
NEWS_TEST_LIVE_PROVIDERS=false
# TECH NEWS CONFIGURATION — END
